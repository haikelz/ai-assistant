#!/usr/bin/env bash
set -euo pipefail

PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH

fail() {
	echo "$1" >&2
	exit 2
}

read_nul() {
	IFS= read -r -d '' "$1"
}

read_arguments() {
	args=()
	while IFS= read -r -d '' argument; do
		args+=("$argument")
	done
	[ "${#args[@]}" -gt 0 ] || fail "missing ${operation} arguments"
}

read_nul operation || fail "missing VPS operation"

[ "${SSH_ORIGINAL_COMMAND:-}" = "/usr/local/libexec/picoclaw-vps-exec" ] || fail "unexpected SSH command"

case "$operation" in
	help)
		cat <<'EOF'
Allowed operations: linux, docker, kubernetes.
EOF
		;;
	linux)
		read_arguments
		exec "${args[@]}"
		;;
	docker|kubernetes)
		read_arguments
		if [ "$operation" = docker ]; then
			exec docker "${args[@]}"
		fi
		exec kubectl "${args[@]}"
		;;
	*)
		fail "unsupported VPS operation"
		;;
esac
