#!/usr/bin/env bash
set -euo pipefail

PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH

fail() {
	echo "$1" >&2
	exit 2
}

read_nul() {
	IFS= read -r -d '' "$1"
}

read_nul operation || fail "missing VPS operation"

[ "${SSH_ORIGINAL_COMMAND:-}" = "/usr/local/libexec/picoclaw-vps-exec" ] || fail "unexpected SSH command"

case "$operation" in
	help)
		cat <<'EOF'
Allowed operations: linux-status, linux-processes, linux-journal, docker, kubernetes.
EOF
		;;
	linux-status)
		hostname -f 2>/dev/null || hostname
		uptime
		df -h /
		free -h
		;;
	linux-processes)
		ps -eo pid,user,comm,%cpu,%mem --sort=-%cpu | sed -n '1,31p'
		;;
	linux-journal)
		read_nul unit || fail "missing systemd unit"
		read_nul lines || fail "missing journal line limit"
		case "$unit" in ''|*[!A-Za-z0-9@_.-]*) fail "invalid systemd unit" ;; esac
		case "$lines" in ''|*[!0-9]*) fail "invalid journal line limit" ;; esac
		[ "$lines" -le 500 ] 2>/dev/null || fail "journal line limit must be at most 500"
		exec journalctl --no-pager -u "$unit" -n "$lines"
		;;
	docker|kubernetes)
		args=()
		while IFS= read -r -d '' argument; do
			args+=("$argument")
		done
		[ "${#args[@]}" -gt 0 ] || fail "missing ${operation} arguments"
		if [ "$operation" = docker ]; then
			exec docker "${args[@]}"
		fi
		exec kubectl "${args[@]}"
		;;
	*)
		fail "unsupported VPS operation"
		;;
esac
